{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/emitten89/cpg-brand-sku-repository-workflow/blob/main/workflow/canonical-manifest.schema.json",
  "title": "CPG canonical snapshot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "schema_version",
    "pipeline_version",
    "snapshot_id",
    "generated_at",
    "client",
    "markets",
    "row_counts",
    "artifacts"
  ],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "schema_version": { "const": "1.0.0" },
    "pipeline_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name"],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "markets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "as_of": { "type": "string", "format": "date" },
        "captured_from": { "type": "string", "format": "date" },
        "captured_to": { "type": "string", "format": "date" }
      }
    },
    "row_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_repository",
        "retailer_model",
        "sku_library",
        "sources",
        "coverage_gaps"
      ],
      "properties": {
        "brand_repository": { "$ref": "#/$defs/rowCount" },
        "retailer_model": { "$ref": "#/$defs/rowCount" },
        "sku_library": { "$ref": "#/$defs/rowCount" },
        "sources": { "$ref": "#/$defs/rowCount" },
        "coverage_gaps": { "$ref": "#/$defs/rowCount" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_repository",
        "retailer_model",
        "sku_library",
        "sources",
        "coverage_gaps",
        "summary"
      ],
      "properties": {
        "brand_repository": { "$ref": "#/$defs/artifact" },
        "retailer_model": { "$ref": "#/$defs/artifact" },
        "sku_library": { "$ref": "#/$defs/artifact" },
        "sources": { "$ref": "#/$defs/artifact" },
        "coverage_gaps": { "$ref": "#/$defs/artifact" },
        "summary": { "$ref": "#/$defs/artifact" }
      }
    }
  },
  "$defs": {
    "rowCount": {
      "type": "integer",
      "minimum": 0
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "bytes", "sha256"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^(?!manifest\\.json$)[^/\\\\]+\\.json$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
