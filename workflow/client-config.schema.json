{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cpg-client-config.schema.json",
  "title": "CPG Repository Client Configuration",
  "type": "object",
  "required": ["slug", "company", "markets", "asOf", "inclusionRule"],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "company": {
      "type": "string",
      "minLength": 1
    },
    "markets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "currencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "inclusionRule": {
      "type": "string",
      "minLength": 20
    },
    "commercialModel": {
      "type": "object"
    },
    "sourceClasses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredSkuFields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}

