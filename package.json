{
  "name": "cpg-brand-sku-repository-workflow",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Evidence-controlled CPG brand/commercial and product/SKU repository workflow.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "scaffold": "node workflow/new-client.mjs",
    "parse:first-party": "node research/parse_exa_catalogs.mjs",
    "parse:retailer": "node research/parse_retail_catalogs.mjs",
    "build:canonical": "node research/build_canonical_data.mjs",
    "manifest:canonical": "node workflow/create-canonical-manifest.mjs research/canonical",
    "validate": "node workflow/validate-canonical.mjs research/canonical",
    "test": "node --test workflow/test/canonical-contract.test.mjs workflow/test/dashboard-build.test.mjs workflow/test/submission-contract.test.mjs",
    "build:site": "node workflow/build-dashboard.mjs",
    "build:submission-api": "node workflow/build-submission-api.mjs",
    "build:workbooks": "node research/build_workbooks.mjs",
    "verify:workbooks": "node research/verify_workbooks.mjs"
  },
  "dependencies": {
    "@neon/functions": "^0.9.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}

